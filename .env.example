# ============================================================
# Agent DocX Builder — Environment Configuration
# ============================================================
# Set ONE of the API keys below.  The provider is auto-detected
# from whichever key is present (or override with LLM_PROVIDER).
# ============================================================

# --- Provider API Keys (set at least one) -------------------

# Groq — free tier, fastest inference (https://console.groq.com)
# GROQ_API_KEY=gsk_your_key_here

# OpenAI — GPT-4o (https://platform.openai.com)
# OPENAI_API_KEY=sk-your_key_here

# Google Gemini (https://aistudio.google.com/apikey)
# GOOGLE_API_KEY=your_google_api_key_here

# Anthropic — Claude (https://console.anthropic.com)
# ANTHROPIC_API_KEY=sk-ant-your_key_here

# OpenRouter — multi-model gateway (https://openrouter.ai)
# OPENROUTER_API_KEY=sk-or-your_key_here

# DeepInfra (https://deepinfra.com)
# DEEPINFRA_API_KEY=your_key_here

# --- Optional overrides -------------------------------------

# Force a specific provider (skip auto-detection):
# LLM_PROVIDER=groq

# Override the default model for your chosen provider:
# LLM_MODEL=llama-3.3-70b-versatile
